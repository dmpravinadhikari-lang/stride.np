# ---------------------------------------------------------------------------
# STRIDE configuration.  Copy this file to .env.local and edit that copy.
# ---------------------------------------------------------------------------

# Which AI engine answers the platform's questions.
#   sample        = built-in canned responses. No setup, no cost, works offline.
#   claude-cli    = the `claude` command on this machine. Free while you build,
#                   but handles one request at a time — laptop and demo only.
#   anthropic-api = the real Claude API. Needed once real students use it.
STRIDE_AI_PROVIDER=sample

# Only used when STRIDE_AI_PROVIDER=claude-cli
STRIDE_CLAUDE_CLI_PATH=claude
STRIDE_CLAUDE_CLI_MODEL=

# Only used when STRIDE_AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=
STRIDE_API_MODEL_SMART=claude-sonnet-5
STRIDE_API_MODEL_FAST=claude-haiku-4-5-20251001

# Where the database file lives (SQLite today, PostgreSQL on the server later).
STRIDE_DB_PATH=./data/stride.db

# Signs login cookies. Change this to any long random string before going live.
STRIDE_SESSION_SECRET=dev-only-change-me-before-you-deploy-anywhere

# The domain consultancy subdomains hang off, e.g. happypanda.stride.com.np
STRIDE_ROOT_DOMAIN=localhost:3000

# How email is sent.
#   outbox = write the message to data/outbox and send nothing (default)
#   smtp   = a real mail server, using the settings below
STRIDE_EMAIL_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=STRIDE <no-reply@stride.np>

# Shared secret for the nightly reminder job. Change it before going live.
STRIDE_CRON_SECRET=dev-cron-secret-change-me

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Left blank, no tag is loaded at all. It is applied to the public marketing
# and tools pages only — never to /app or to a parent's progress page.
NEXT_PUBLIC_GA_ID=

# Google sign-in. Create an OAuth client at console.cloud.google.com and add
# <your site>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# SMS. Same pattern as the AI engine and email: outbox while building, a real
# gateway when you are ready.
#
#   outbox   writes to data/outbox-sms, sends nothing, costs nothing
#   sparrow  Sparrow SMS, the Nepali gateway, roughly NPR 1.40 a message
#
# SPARROW_FROM is the sender identity and must be registered with NTC and
# Ncell before anything will deliver. An unregistered one is rejected, not
# queued.
# ---------------------------------------------------------------------------
STRIDE_SMS_PROVIDER=outbox
SPARROW_TOKEN=
SPARROW_FROM=
