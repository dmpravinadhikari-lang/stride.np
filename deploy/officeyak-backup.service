# One encrypted archive of the database and the uploaded documents.
[Unit]
Description=OfficeYak backup
After=officeyak.service

[Service]
Type=oneshot
User=officeyak
Group=officeyak
WorkingDirectory=/srv/officeyak
EnvironmentFile=/etc/officeyak/officeyak.env
ExecStart=/usr/bin/npm run backup
# Copying it off this machine is the half that makes it a backup. Put your own
# command here: rclone to a bucket, rsync to another box, anything that is not
# this disk.
# ExecStartPost=/usr/bin/rclone copy /srv/officeyak/data/backups remote:officeyak-backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=officeyak-backup
