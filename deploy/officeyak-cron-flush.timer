# Anything written between runs goes out within the quarter hour. Invitations
# and password links do not wait for this: they are posted as they are written.
[Unit]
Description=OfficeYak mail flush, every fifteen minutes

[Timer]
OnCalendar=*:0/15
Persistent=false
Unit=officeyak-cron@flush.service

[Install]
WantedBy=timers.target
