# /etc/officeyak/officeyak.env
#
#   sudo mkdir -p /etc/officeyak
#   sudo cp deploy/officeyak.env.example /etc/officeyak/officeyak.env
#   sudo chown root:root /etc/officeyak/officeyak.env
#   sudo chmod 600 /etc/officeyak/officeyak.env
#
# Then fill in every line marked CHANGE ME. `npm run preflight` refuses to
# start the server until the ones that matter are right.

# --------------------------------------------------------------- the basics
# The host only, with no scheme and no trailing slash. Consultancy addresses
# are built from it, and Server Actions check the Origin header against it.
OFFICEYAK_ROOT_DOMAIN=officeyak.com
NEXT_PUBLIC_SITE_URL=https://officeyak.com

# --------------------------------------------------------------- the secrets
# Generate each one separately:  openssl rand -base64 32
# Losing OFFICEYAK_FILE_KEY loses every uploaded document. Losing
# OFFICEYAK_BACKUP_KEY loses every backup. Keep a copy of both somewhere that is
# not this server.
OFFICEYAK_SESSION_SECRET=CHANGE_ME
OFFICEYAK_FILE_KEY=CHANGE_ME
OFFICEYAK_BACKUP_KEY=CHANGE_ME

# The bearer token the cron lines present. Any long random string.
OFFICEYAK_CRON_SECRET=CHANGE_ME

# ----------------------------------------------------------------- the disks
OFFICEYAK_DB_PATH=/srv/officeyak/data/officeyak.db
OFFICEYAK_UPLOAD_DIR=/srv/officeyak/data/uploads
OFFICEYAK_BACKUP_DIR=/srv/officeyak/data/backups
OFFICEYAK_BACKUP_KEEP_DAYS=90

# ----------------------------------------------------------------- the email
# Real mail, or students never receive their sign-in details. The from address
# must be on a domain whose SPF, DKIM and DMARC records name this sender, or
# every message lands in spam. See docs/deploy.md.
OFFICEYAK_EMAIL_PROVIDER=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# Quoted, because this value has spaces in it and the runbook sources this
# file by hand to run the preflight.
SMTP_FROM="OfficeYak <no-reply@officeyak.com>"

# -------------------------------------------------------------------- the AI
# sample answers with canned text, which is fine for a demo and wrong for
# customers. anthropic-api needs a key.
OFFICEYAK_AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=CHANGE_ME

# ------------------------------------------------------------------ optional
# Sign in with Google, from the Google Cloud console. Leave blank to switch it
# off: email and password still work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Visitor counts on the public pages only. Leave blank and nothing is loaded.
# NEXT_PUBLIC_GA_ID=

# Text message reminders, from sparrowsms.com. Leave the provider unset and
# nothing is sent.
# OFFICEYAK_SMS_PROVIDER=sparrow
# SPARROW_TOKEN=
# SPARROW_FROM=

# Which models the AI tools use. The defaults in the code are current; set
# these only to pin a particular one.
# OFFICEYAK_API_MODEL_FAST=
# OFFICEYAK_API_MODEL_SMART=
