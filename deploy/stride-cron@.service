# One scheduled run of STRIDE's jobs. The instance name is what to run:
# daily, weekly or flush.
#
#   systemctl start stride-cron@daily
#
# A systemd unit rather than a line in /etc/cron.d, for one reason: cron would
# have no way to read the bearer token. The token lives in a root-owned file
# that the stride user cannot read, and systemd loads it as root before
# dropping to that user. Putting the token in a crontab instead would mean a
# world-readable file holding the key to every scheduled job.

[Unit]
Description=STRIDE scheduled run (%i)
After=stride.service
Requires=stride.service

[Service]
Type=oneshot
User=stride
Group=stride
EnvironmentFile=/etc/stride/stride.env
ExecStart=/bin/sh -c 'curl -fsS -m 300 -H "Authorization: Bearer $STRIDE_CRON_SECRET" "http://127.0.0.1:3000/api/cron/alerts?run=%i"'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stride-cron
