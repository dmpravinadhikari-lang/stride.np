# /etc/stride/stride.env
#
#   sudo mkdir -p /etc/stride
#   sudo cp deploy/stride.env.example /etc/stride/stride.env
#   sudo chown root:root /etc/stride/stride.env
#   sudo chmod 600 /etc/stride/stride.env
#
# Then fill in every line marked CHANGE ME. `npm run preflight` refuses to
# start the server until the ones that matter are right.

# --------------------------------------------------------------- the basics
# The host only, with no scheme and no trailing slash. Consultancy addresses
# are built from it, and Server Actions check the Origin header against it.
STRIDE_ROOT_DOMAIN=stride.com.np
NEXT_PUBLIC_SITE_URL=https://stride.com.np

# --------------------------------------------------------------- the secrets
# Generate each one separately:  openssl rand -base64 32
# Losing STRIDE_FILE_KEY loses every uploaded document. Losing
# STRIDE_BACKUP_KEY loses every backup. Keep a copy of both somewhere that is
# not this server.
STRIDE_SESSION_SECRET=CHANGE_ME
STRIDE_FILE_KEY=CHANGE_ME
STRIDE_BACKUP_KEY=CHANGE_ME

# The bearer token the cron lines present. Any long random string.
STRIDE_CRON_SECRET=CHANGE_ME

# ----------------------------------------------------------------- the disks
STRIDE_DB_PATH=/srv/stride/data/stride.db
STRIDE_UPLOAD_DIR=/srv/stride/data/uploads
STRIDE_BACKUP_DIR=/srv/stride/data/backups
STRIDE_BACKUP_KEEP_DAYS=90

# ----------------------------------------------------------------- the email
# Real mail, or students never receive their sign-in details. The from address
# must be on a domain whose SPF, DKIM and DMARC records name this sender, or
# every message lands in spam. See docs/deploy.md.
STRIDE_EMAIL_PROVIDER=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=STRIDE <no-reply@stride.com.np>

# -------------------------------------------------------------------- the AI
# sample answers with canned text, which is fine for a demo and wrong for
# customers. anthropic-api needs a key.
STRIDE_AI_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=CHANGE_ME

# ------------------------------------------------------------------ optional
# Sign in with Google, from the Google Cloud console. Leave blank to switch it
# off: email and password still work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Visitor counts on the public pages only. Leave blank and nothing is loaded.
# NEXT_PUBLIC_GA_ID=

# Text message reminders, from sparrowsms.com. Leave the provider unset and
# nothing is sent.
# STRIDE_SMS_PROVIDER=sparrow
# SPARROW_TOKEN=
# SPARROW_FROM=

# Which models the AI tools use. The defaults in the code are current; set
# these only to pin a particular one.
# STRIDE_API_MODEL_FAST=
# STRIDE_API_MODEL_SMART=
