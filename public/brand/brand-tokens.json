  "spacing": 8,
  "maxContentWidth": 1200,
  "gutter": 24,
  "sectionPadding": {
    "desktop": 96,
    "mobile": 56
  },
  "shadow": {
    "glass": "0 8px 24px rgba(21,19,58,0.12)",
    "card": "0 6px 18px rgba(21,19,58,0.08)"
  },
  "glass": {
    "background": "rgba(255,255,255,0.55)",
    "border": "1px solid rgba(255,255,255,0.7)",
    "blur": "14px"
  },
  "watermark": {
    "onPaper": {
      "color": "#15133A",
      "opacity": 0.06
    },
    "onNavy": {
      "color": "#fff",
      "opacity": 0.08
    }
  },
  "logo": {
    "lockupGap": "0.3 × bellHeight",
    "wordmarkCap": "≈0.8 × bellHeight",
    "clearSpace": "bellHeight / 2",
    "minLockupPx": 120,
    "minBellPx": 16,
    "minHornYPx": 12,
    "favicon": "horn-y at 16/32, bell at 48+",
    "appIcon": "navy tile, bell-on-dark at 64%, ridge-mono white 8% at base"
  },
  "motifs": {
    "ridge": "three peaks pink→orange→yellow left to right; bottom of hero, top of footer (flipped, 18%), bottom of Navy social posts (≤22% height), app icon base",
    "bellWatermark": "6–8%, cropped to a corner, never with wordmark"
  },
