  "colorNames": {
    "navy": "Night Navy",
    "orange": "Yak Orange",
    "yellow": "Summit Yellow",
    "pink": "Rhododendron Pink"
  },
  "roles": {
    "navy": "text, structure, rail, footer, dark bands",
    "orange": "the single action colour: primary button, active nav, links (use linkOnLight on Paper)",
    "yellow": "highlight, KPI rule, AI callout ground (Ink text on top)",
    "pink": "accent: new-lead badge, small chart series; never large fills"
  },
  "proportion": {
    "paper": 60,
    "navy": 22,
    "orange": 10,
    "yellow": 5,
    "pink": 3
  },
  "font": {
    "brand": "Outfit",
    "weights": [
      400,
      500,
      600,
      700
    ],
    "mono": "JetBrains Mono",
    "headingTracking": "-0.03em",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap"
  },
  "type": {
    "display": {
      "size": 48,
      "weight": 600,
      "tracking": "-0.035em"
    },
    "h1": {
      "size": 32,
      "weight": 600
    },
    "h2": {
      "size": 20,
      "weight": 600
    },
    "body": {
      "size": 15,
      "weight": 400,
      "lineHeight": 1.55
    },
    "label": {
      "size": 12,
      "weight": 500,
      "tracking": "0.04em",
      "uppercase": true
    },
    "tableHead": {
      "size": 10,
      "weight": 500,
      "tracking": "0.06em",
      "uppercase": true
    },
    "tableRow": {
      "size": 12,
      "height": 36
    }
  },
  "radius": {
    "card": 16,
    "button": 10,
    "input": 8,
    "pill": 999,
    "appIcon": "28%",
    "glass": 14
